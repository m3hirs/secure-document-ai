DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/secure_document_ai
APP_ENVIRONMENT=development
DOCUMENT_STORAGE_DIR=data/documents
CHUNK_MAX_CHARACTERS=1500
CHUNK_OVERLAP_CHARACTERS=200
CHUNKING_VERSION=v1
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_CACHE_DIR=E:\AI-Models
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_VERSION=e5-small-v1
# Local Ollama model used for summaries and grounded answer generation.
OLLAMA_MODEL_NAME=hf.co/bartowski/krutrim-ai-labs_Krutrim-2-instruct-GGUF:Q4_K_M
SEMANTIC_SEARCH_TOP_K=10
SEMANTIC_SEARCH_MAX_TOP_K=50
# Minimum cosine similarity for normalized E5 query/passage vectors.
SEMANTIC_SEARCH_MIN_SIMILARITY=0.81
APP_TIMEZONE=Asia/Kolkata
# Optional local OCR executable. OCR degrades gracefully when unavailable.
TESSERACT_CMD=D:\Tesseract\tesseract.exe
# Local HTTP development uses a non-__Host cookie. Production must override
# the name with a __Host- prefix and set SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_NAME=secure_document_session
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
SESSION_TOKEN_BYTES=32
# Exact browser origins allowed to submit credentials or authenticated
# mutations. Pydantic settings reads this JSON array from the environment.
FRONTEND_ALLOWED_ORIGINS=["http://localhost:5173"]
